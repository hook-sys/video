# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI: product brief (required for brief) ---
OPENAI_API_KEY=
# Defaults to gpt-5-mini
OPENAI_MODEL=

# --- Fal: voice + images (required for voice/assets) ---
FAL_KEY=
FAL_VOICE_MODEL=
# JSON with {{text}}, {{language}}, {{style}}, {{gender}} (male/female); defaults to {"text":"{{text}}"}
FAL_VOICE_INPUT_TEMPLATE=
FAL_IMAGE_MODEL=
# JSON with {{prompt}}, {{format}}; defaults to {"prompt":"{{prompt}}"}
FAL_IMAGE_INPUT_TEMPLATE=

# --- Browsers (optional) ---
# Chromium for website capture (playwright-core). Unset = capture fails gracefully.
CHROMIUM_EXECUTABLE_PATH=
# Chrome headless shell for Remotion rendering. Unset = Remotion downloads its own.
REMOTION_BROWSER_EXECUTABLE=

# --- Dev tools (optional) ---
# "true" enables benchmark, cost breakdown and storyboard preview on a deployment
# (e.g. Vercel Preview). Never set in Production.
ENABLE_DEV_TOOLS=

# --- Cost estimates (optional) ---
# Overrides for lib/costs/pricing.ts (all rates default to 0), e.g.
# {"openai":{"<OPENAI_MODEL>":{"input_per_1m_tokens":0,"output_per_1m_tokens":0}},"fal":{"<FAL_VOICE_MODEL>":{"per_unit":0},"<FAL_IMAGE_MODEL>":{"per_unit":0}},"render":{"1080p":{"per_video_second":0},"4k":{"per_video_second":0}},"storage":{"per_gb_month":0}}
COST_PRICING_JSON=
