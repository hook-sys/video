# MotionDots on your own server (VPS). Copy to /home/motiondots/app/.env.production
# and fill in the values. NEVER commit the filled file, never paste it in a chat.
# The same values you have in Vercel → Project → Settings → Environment Variables.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- fal (voice) — as in Vercel ---
FAL_KEY=
FAL_VOICE_MODEL=
FAL_VOICE_INPUT_TEMPLATE=
FAL_VOICE_MALE=
FAL_VOICE_FEMALE=
FAL_LLM_BASE_URL=

# --- OpenAI (only if set in Vercel) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- this server ---
# the video is made on this machine (not a Vercel Sandbox)
RENDER_MODE=local
# cores one render may use (empty: all of them)
RENDER_CONCURRENCY=
# a long random text: the key the sign-up addresses are hashed with
# (make one with:  openssl rand -hex 32)
IP_HASH_SECRET=
# a long random text: only our own cron may call /api/keep-alive
# (make one with:  openssl rand -hex 32)
CRON_SECRET=
NODE_ENV=production
